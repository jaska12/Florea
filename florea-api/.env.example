# Copy this file to .env and fill it in. .env is not in git; never commit real values.

# Ports of the two apps
PORT_API=3007
PORT_BATCH=3008

# MongoDB: MONGO_DEV is used unless NODE_ENV is "production", which uses MONGO_PROD
MONGO_DEV=
MONGO_PROD=

# Signs the login tokens: a long random text
SECRET_TOKEN=

# AI features (gift assistant, card messages, product descriptions) call the OpenAI API.
# Without a key they answer with a friendly "not available" message and the rest of the site works.
OPENAI_API_KEY=
# The model to use; when empty: gpt-6-luna
AI_MODEL=
