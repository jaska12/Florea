# The three addresses the client needs. Next.js reads them when it starts (yarn dev) or builds (yarn build),
# so a production build needs them in .env.production before "yarn build"; without them the built site
# cannot reach the API. Copy this file to .env.development for local work.
REACT_APP_API_URL=http://localhost:3007
REACT_APP_API_GRAPHQL_URL=http://localhost:3007/graphql
REACT_APP_API_WS=ws://localhost:3007
